{
  "name": "nodejs-service-boilerplate",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Node.js service boilerplate for MyTelkomsel services.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "api:lint": "redocly lint docs/openapi.yaml",
    "postman:run": "postman collection run postman/collections/nodejs-service-boilerplate -e postman/environments/local.yaml",
    "kustomize:build": "kubectl kustomize deploy/kustomize/base && kubectl kustomize deploy/kustomize/overlays/development",
    "check": "npm run format:check && npm run lint && npm run test:coverage && npm run api:lint",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "REPLACE_WITH_SERVICE_REPOSITORY_URL"
  },
  "engines": {
    "node": ">=20.16.0 <23",
    "npm": ">=10"
  },
  "_moduleAliases": {
    "@": "src"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "lru-cache": "^10.4.3",
    "module-alias": "^2.2.3",
    "module-common-function": "https://jfrog.cicd.telkomsel.co.id/artifactory/npm-local/module-common-function/-/module-common-function-1.0.186.tgz",
    "module-config-db": "https://jfrog.cicd.telkomsel.co.id/artifactory/npm-local/module-config-db/-/module-config-db-1.0.16.tgz"
  },
  "devDependencies": {
    "@redocly/cli": "^1.25.10",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.9.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-sonar": "^0.2.16",
    "lint-staged": "^15.2.10",
    "prettier": "^3.5.0",
    "supertest": "^7.0.0"
  },
  "lint-staged": {
    "*.{js,cjs,json,yaml,yml,md}": [
      "prettier --write"
    ],
    "*.{js,cjs}": [
      "eslint --fix"
    ]
  }
}
