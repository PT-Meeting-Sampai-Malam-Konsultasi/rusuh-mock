NODE_ENV=development
PORT=8080
BODY_LIMIT=100kb
# Comma-separated CORS origins (optional; empty or unset = default).
# Default: https://rusuh-tiket.web.id,https://www.rusuh-tiket.web.id,http://localhost:3000,http://localhost:5173
CORS_ORIGINS=
ENABLE_DUPLICATE_JSON_KEY_VALIDATION=false
CACHE_ENABLED=false
CACHE_MAX_ENTRIES=500
CACHE_TTL_MS=900000
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
